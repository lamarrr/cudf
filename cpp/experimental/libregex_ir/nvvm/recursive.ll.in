; BEGIN run_block_prefix
define internal i1 @{0}(i32 %block, i8* %data, i64 %size, i64* %position, i64* %captures, i64 %steps) nounwind {{
entry:
  %exhausted = icmp eq i64 %steps, 0
  %next_steps = sub i64 %steps, 1
  br i1 %exhausted, label %return_fail, label %dispatch
dispatch:
  switch i32 %block, label %return_fail [
{1}  ]
; END run_block_prefix

; BEGIN run_block_suffix
return_success:
  ret i1 true
return_fail:
  ret i1 false
}
; END run_block_suffix

; BEGIN boolean_execute_prefix
define zeroext i1 @{0}(i8* %data, i64 %size) nounwind readonly {{
entry:
  %position = alloca i64, align 8
  %size_plus_one = add i64 %size, 1
  %step_limit = mul i64 %size_plus_one, {1}
; END boolean_execute_prefix

; BEGIN find_from_prefix
define internal i1 @{0}(i8* %data, i64 %size, i64 %search_start, i64* %match_begin, i64* %match_end, i64* %captures) nounwind {{
entry:
  %position = alloca i64, align 8
  %size_plus_one = add i64 %size, 1
  %step_limit = mul i64 %size_plus_one, {1}
{2}search:
  %start = phi i64 [ %search_start, {3} ], [ %next_start, %continue ]
  %in_range = icmp ule i64 %start, %size
; END find_from_prefix

; BEGIN recursive_execute_prefix_search
  br label %search
search:
  %start = phi i64 [ 0, {6} ], [ %next_start, %next ]
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %attempt, label %filter
filter:
  %start_ptr = getelementptr i8, i8* %data, i64 %start
  %start_byte = call i32 @{0}(i8* %start_ptr)
  %candidate = icmp eq i32 %start_byte, {1}
{2}  br i1 {3}, label %attempt, label %skip
skip:
  %is_ascii = icmp ult i32 %start_byte, 128
  br i1 %is_ascii, label %continue_ascii, label %continue_utf8
attempt:
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{4}(i32 {5}, i8* %data, i64 %size, i64* %position, i64* null, i64 %step_limit)
  br i1 %matched, label %yes, label %check_end
check_end:
  br i1 %at_end, label %no, label %continue_ascii
continue_ascii:
  %prefix_seek_start = add nuw i64 %start, 1
  %ascii_next = call i64 @regex_ir_seek_byte(i8* %data, i64 %size, i64 %prefix_seek_start, i32 {1})
  br label %next
continue_utf8:
  br label %continue_ascii
next:
  %next_start = phi i64 [ %ascii_next, %continue_ascii ]
  br label %search
yes:
  ret i1 true
no:
  ret i1 false
}}
; END recursive_execute_prefix_search

; BEGIN recursive_execute_suffix
  br label %search
search:
  %start = phi i64 [ 0, {3} ], [ %next_start, %continue ]
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{0}(i32 {1}, i8* %data, i64 %size, i64* %position, i64* null, i64 %step_limit)
  br i1 %matched, label %yes, label %check_end
check_end:
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %no, label %continue
continue:
  %next_start = call i64 @{2}(i8* %data, i64 %size, i64 %start, i64 1)
  br label %search
yes:
  ret i1 true
no:
  ret i1 false
}}
; END recursive_execute_suffix

; BEGIN n_pos_n
  %{0}_pos_{1} = load i64, i64* %position, align 8
  %{0}_peek_{1} = call i1 @{2}(i8* %data, i64 %size, i64 %{0}_pos_{1}, i64 {3})
  br i1 %{0}_peek_{1}, label %{4}, label %return_fail
; END n_pos_n

; BEGIN n_capture_end_ptr_n
  %{0}_capture_end_ptr_{1} = getelementptr i64, i64* %captures, i64 {2}
  store i64 -1, i64* %{0}_capture_end_ptr_{1}, align 8
; END n_capture_end_ptr_n

; BEGIN n_capture_pos_n
  %{0}_capture_pos_{1} = load i64, i64* %position, align 8
  %{0}_capture_ptr_{1} = getelementptr i64, i64* %captures, i64 {2}
  store i64 %{0}_capture_pos_{1}, i64* %{0}_capture_ptr_{1}, align 8
{3}  br label %{4}
; END n_capture_pos_n

; BEGIN n_match_pos_n
  %{0}_match_pos_{1} = load i64, i64* %position, align 8
  %{0}_match_{1} = call i1 @{2}(i8* %data, i64 %size, i64 %{0}_match_pos_{1})
  br i1 %{0}_match_{1}, label %{3}, label %return_fail
; END n_match_pos_n

; BEGIN n_literal_pos_n
  %{0}_literal_pos_{1} = load i64, i64* %position, align 8
  %{0}_literal_{1} = call i1 @{2}(i8* %data, i64 %size, i64 %{0}_literal_pos_{1})
  br i1 %{0}_literal_{1}, label %{3}, label %return_fail
; END n_literal_pos_n

; BEGIN n_advance_pos_n
  %{0}_advance_pos_{1} = load i64, i64* %position, align 8
  %{0}_advanced_{1} = add i64 %{0}_advance_pos_{1}, {2}
  store i64 %{0}_advanced_{1}, i64* %position, align 8
  br label %{3}
; END n_advance_pos_n

; BEGIN n_advance_pos_n_2
  %{0}_advance_pos_{1} = load i64, i64* %position, align 8
  %{0}_advanced_{1} = call i64 @{2}(i8* %data, i64 %size, i64 %{0}_advance_pos_{1}, i64 {3})
  store i64 %{0}_advanced_{1}, i64* %position, align 8
  br label %{4}
; END n_advance_pos_n_2

; BEGIN n_assert_pos_n
  %{0}_assert_pos_{1} = load i64, i64* %position, align 8
  %{0}_assert_{1} = call i1 @{2}(i8* %data, i64 %size, i64 %{0}_assert_pos_{1}, i32 {3}, i1 {5}, i1 {6})
  br i1 %{0}_assert_{1}, label %{4}, label %return_fail
; END n_assert_pos_n

; BEGIN n_accept_pos
  %{}_accept_pos = load i64, i64* %position, align 8
  %{}_accept = icmp eq i64 %{}_accept_pos, %size
  ret i1 %{}_accept
; END n_accept_pos

; BEGIN n_saved_capture_n
  %{0}_saved_capture_{1} = getelementptr i64, i64* %captures, i64 {1}
  %{0}_saved_capture_value_{1} = load i64, i64* %{0}_saved_capture_{1}, align 8
; END n_saved_capture_n

; BEGIN n_attempt_n
{0}_attempt_{1}:
  %{0}_child_{1} = call i1 @{2}(i32 {3}, i8* %data, i64 %size, i64* %position, i64* %captures, i64 %next_steps)
  br i1 %{0}_child_{1}, label %return_success, label %{0}_restore_{1}
{0}_restore_{1}:
  store i64 %{0}_saved, i64* %position, align 8
; END n_attempt_n

; BEGIN store_store_i64_0_i64_position_align_8
  store i64 0, i64* %position, align 8
  %matched = call i1 @{0}(i32 {1}, i8* %data, i64 %size, i64* %position, i64* null, i64 %step_limit)
  ret i1 %matched
}}
; END store_store_i64_0_i64_position_align_8

; BEGIN mandatory_at_begin
  %mandatory_at_begin = icmp eq i64 %search_start, 0
  br i1 %mandatory_at_begin, label %mandatory_filter, label %mandatory_filter_done
mandatory_filter:
  %mandatory_present = call i1 @{}(i8* %data, i64 %size, i64 %search_start)
  br i1 %mandatory_present, label %mandatory_filter_done, label %no
mandatory_filter_done:
  br label %search
; END mandatory_at_begin

; BEGIN branch_br_i1_in_range_label_prefix_end_label_no
  br i1 %in_range, label %prefix_end, label %no
prefix_end:
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %initialize, label %prefix_filter
prefix_filter:
  %prefix_ptr = getelementptr i8, i8* %data, i64 %start
  %prefix_byte = call i32 @{0}(i8* %prefix_ptr)
  %prefix_candidate = icmp eq i32 %prefix_byte, {1}
{2}  br i1 {3}, label %initialize, label %continue
; END branch_br_i1_in_range_label_prefix_end_label_no

; BEGIN find_capture_ptr_0
  %find_capture_ptr_0 = getelementptr i64, i64* %captures, i64 0
  %find_capture_ptr_1 = getelementptr i64, i64* %captures, i64 1
; END find_capture_ptr_0

; BEGIN find_capture_ptr_n
  %find_capture_ptr_{0} = getelementptr i64, i64* %captures, i64 {0}
  store i64 -1, i64* %find_capture_ptr_{0}, align 8
; END find_capture_ptr_n

; BEGIN store_store_i64_start_i64_position_align_8
  store i64 %start, i64* %position, align 8
  %matched = call i1 @{0}(i32 {1}, i8* %data, i64 %size, i64* %position, i64* {2}, i64 %step_limit)
  br i1 %matched, label %yes, label %check_end
check_end:
; END store_store_i64_start_i64_position_align_8

; BEGIN at_end
  %at_end = icmp eq i64 %start, %size
  br i1 %at_end, label %no, label %continue
; END at_end

; BEGIN prefix_seek_start
  %prefix_seek_start = add nuw i64 %start, 1
  %next_start = call i64 @regex_ir_seek_byte(i8* %data, i64 %size, i64 %prefix_seek_start, i32 {})
; END prefix_seek_start

; BEGIN continue
continue:
{0}
  br label %search
yes:
  %accepted_end = load i64, i64* %position, align 8
  store i64 %start, i64* %match_begin, align 8
  store i64 %accepted_end, i64* %match_end, align 8
; END continue

; BEGIN return_ret_i1_true
  ret i1 true
no:
  ret i1 false
}}
; END return_ret_i1_true
